; Digimon MMO Framework — UE5.8 project integration snippet
; MERGE these entries into <YourProject>/Config/DefaultGame.ini.
; Do NOT replace the project's existing Asset Manager array or clear its existing types.
; Recommended content layout: /Game/DigimonData/...

[/Script/Engine.AssetManagerSettings]
+PrimaryAssetTypesToScan=(PrimaryAssetType="DMFDigimonSpecies",AssetBaseClass="/Script/DigimonMMOFramework.DMFDigimonSpeciesData",bHasBlueprintClasses=False,bIsEditorOnly=False,Directories=((Path="/Game/DigimonData")),SpecificAssets=,Rules=(Priority=-1,ChunkId=-1,bApplyRecursively=True,CookRule=AlwaysCook))
+PrimaryAssetTypesToScan=(PrimaryAssetType="DMFStarterRoster",AssetBaseClass="/Script/DigimonMMOFramework.DMFStarterRosterData",bHasBlueprintClasses=False,bIsEditorOnly=False,Directories=((Path="/Game/DigimonData")),SpecificAssets=,Rules=(Priority=-1,ChunkId=-1,bApplyRecursively=True,CookRule=AlwaysCook))
+PrimaryAssetTypesToScan=(PrimaryAssetType="DMFDigimonAbility",AssetBaseClass="/Script/DigimonMMOFramework.DMFDigimonAbilityData",bHasBlueprintClasses=False,bIsEditorOnly=False,Directories=((Path="/Game/DigimonData")),SpecificAssets=,Rules=(Priority=-1,ChunkId=-1,bApplyRecursively=True,CookRule=AlwaysCook))
+PrimaryAssetTypesToScan=(PrimaryAssetType="DMFPlayerSkin",AssetBaseClass="/Script/DigimonMMOFramework.DMFPlayerSkinData",bHasBlueprintClasses=False,bIsEditorOnly=False,Directories=((Path="/Game/DigimonData")),SpecificAssets=,Rules=(Priority=-1,ChunkId=-1,bApplyRecursively=True,CookRule=AlwaysCook))


; v0.8.0 Care defaults. Asset references can be assigned more safely in Project Settings.
[/Script/DigimonMMOFramework.DMFFrameworkSettings]
bEnableCareSystem=True
CareServerTickInterval=10.0
CarePresentationLeadInSeconds=0.35
CareInterServingPauseSeconds=0.20
CareFallbackMontageDurationSeconds=1.0
; DefaultDigiMeatMesh=/Game/...
; DefaultPooMesh=/Game/...


; v0.9.x automatic MMO world-nameplate defaults.
[/Script/DigimonMMOFramework.DMFFrameworkSettings]
bEnableWorldNameplates=True
bEnablePlayerNameplates=True
bShowLocalPlayerNameplate=False
PlayerNameplateMaxDrawDistance=6000.0
PlayerNameplateHeightOffset=34.0
bEnableDigimonNameplates=True
DigimonNameplateMaxDrawDistance=4500.0
DigimonNameplateHeightOffset=24.0
bShowDigimonNumericHealthOnNameplates=True
WorldNameplateRefreshInterval=0.15

; v0.10.1 polished native MMO world-chat defaults + HUD-safe layout.
[/Script/DigimonMMOFramework.DMFFrameworkSettings]
bEnableWorldChat=True
bEnableDefaultWorldChatInput=True
WorldChatMaxMessageLength=220
WorldChatClientHistoryLimit=100
WorldChatServerHistoryLimit=50
WorldChatMinimumSendInterval=0.65
WorldChatBurstWindowSeconds=10.0
WorldChatMaxMessagesPerBurst=8
bShowWorldChatTimestamps=False
WorldChatBottomSafeOffset=176.0

